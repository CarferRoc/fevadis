# Supabase — app web (Vite)
# Usa ÚNICAMENTE la publishable/anon key. NUNCA una service_role / secret key:
# cualquier visitante puede extraerla del bundle, y Supabase además bloquea
# el uso de claves secret en navegador.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
